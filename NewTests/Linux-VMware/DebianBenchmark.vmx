#!/usr/bin/vmware
.encoding = "UTF-8"
config.version = "8"
virtualHW.version = "21"
displayName = "DebianBenchmark"
guestOS = "debian13-64"
numvcpus = "4"
cpuid.coresPerSocket = "4"
memsize = "16384"
firmware = "bios"

# --- PCI/PCIe bridges (required so pvscsi + vmxnet3 can register PCI slots) ---
pciBridge0.present = "TRUE"
pciBridge4.present = "TRUE"
pciBridge4.virtualDev = "pcieRootPort"
pciBridge4.functions = "8"
pciBridge5.present = "TRUE"
pciBridge5.virtualDev = "pcieRootPort"
pciBridge5.functions = "8"
pciBridge6.present = "TRUE"
pciBridge6.virtualDev = "pcieRootPort"
pciBridge6.functions = "8"
pciBridge7.present = "TRUE"
pciBridge7.virtualDev = "pcieRootPort"
pciBridge7.functions = "8"

# --- Disk: pvscsi + VMDK (matches Win-VmWare .vmx + bench.conf DISK_TYPE) ---
scsi0.present = "TRUE"
scsi0.virtualDev = "pvscsi"
scsi0:0.present = "TRUE"
scsi0:0.fileName = "benchmark-disk.vmdk"
scsi0:0.deviceType = "disk"

# --- cloud-init seed as a CD-ROM (SATA) ---
sata0.present = "TRUE"
sata0:0.present = "TRUE"
sata0:0.fileName = "seed.iso"
sata0:0.deviceType = "cdrom-image"

# --- NIC: vmxnet3 (paravirtual) on VMware NAT (vmnet8) ---
ethernet0.present = "TRUE"
ethernet0.virtualDev = "vmxnet3"
ethernet0.connectionType = "nat"
ethernet0.addressType = "generated"

# --- serial console to file (genericcloud logs to ttyS0) for diagnostics ---
serial0.present = "TRUE"
serial0.fileType = "file"
serial0.fileName = "ttyS0.log"
serial0.yieldOnMsrRead = "TRUE"

# --- headless / trim ---
tools.syncTime = "FALSE"
usb.present = "FALSE"
sound.present = "FALSE"
mks.enable3d = "FALSE"
virtualHW.productCompatibility = "hosted"
vmxstats.filename = "DebianBenchmark.scoreboard"
numa.autosize.cookie = "40042"
numa.autosize.vcpu.maxPerVirtualNode = "4"
uuid.bios = "56 4d 72 88 26 c6 7f ff-3d 2b 0d c5 36 9d 04 34"
uuid.location = "56 4d 72 88 26 c6 7f ff-3d 2b 0d c5 36 9d 04 34"
pciBridge0.pciSlotNumber = "17"
pciBridge4.pciSlotNumber = "21"
pciBridge5.pciSlotNumber = "22"
pciBridge6.pciSlotNumber = "23"
pciBridge7.pciSlotNumber = "24"
scsi0.pciSlotNumber = "160"
ethernet0.pciSlotNumber = "192"
sata0.pciSlotNumber = "32"
scsi0:0.redo = ""
scsi0.sasWWID = "50 05 05 68 26 c6 7f f0"
svga.vramSize = "268435456"
vmotion.checkpointFBSize = "134217728"
vmotion.checkpointSVGAPrimarySize = "268435456"
vmotion.svga.mobMaxSize = "268435456"
vmotion.svga.graphicsMemoryKB = "262144"
ethernet0.generatedAddress = "00:0c:29:9d:04:34"
ethernet0.generatedAddressOffset = "0"
monitor.phys_bits_used = "45"
cleanShutdown = "FALSE"
softPowerOff = "FALSE"
toolsInstallManager.updateCounter = "1"
extendedConfigFile = "DebianBenchmark.vmxf"
